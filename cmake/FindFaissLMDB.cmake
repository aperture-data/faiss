find_path(FAISS_LMDB_INCLUDE_DIR lmdb.h REQUIRED)
find_library(FAISS_LMDB_LIBRARY NAMES lmdb REQUIRED)
if(NOT TARGET FAISS::LMDB)
  add_library(FAISS::LMDB UNKNOWN IMPORTED)
  set_target_properties(FAISS::LMDB PROPERTIES
    IMPORTED_LOCATION "${FAISS_LMDB_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${FAISS_LMDB_INCLUDE_DIR}")
endif()
mark_as_advanced(FAISS_LMDB_INCLUDE_DIR FAISS_LMDB_LIBRARY)
